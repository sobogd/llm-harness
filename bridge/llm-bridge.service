[Unit]
Description=llm-harness bridge (llm.iq-factura.com -> mac harness)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/llm-bridge
ExecStart=/opt/llm-bridge/.venv/bin/python /opt/llm-bridge/bridge/server.py /root/.llm-bridge.json
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
